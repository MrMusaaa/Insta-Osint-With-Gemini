# =====================================================================
# Instagram Public Index OSINT Suite - Environment Configuration
# =====================================================================
# KULLANIM: Bu dosyayı '.env' olarak kopyalayın ve kendi API anahtarlarınızı girin.
# DİKKAT: '.env' dosyanızı ASLA GitHub veya genel ortamlara yüklemeyin!
# =====================================================================

# 1. Google Gemini API Anahtarı (Metin ve Dilbilimsel OSINT Analizi için)
# https://aistudio.google.com/ adresinden ücretsiz edinebilirsiniz.
GEMINI_API_KEY=""

# 2. Google Custom Search (İsteğe Bağlı - Programlanabilir Arama Motoru JSON API)
# https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# 3. İstemci Tarafı Google CSE Entegrasyonu (İsteğe Bağlı)
VITE_GOOGLE_SEARCH_CX=""

# 4. Sunucu Yapılandırması
PORT=3000
